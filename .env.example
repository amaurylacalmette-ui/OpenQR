# ---------------------------------------------------------------------------
# OpenQR — environment configuration
#
# 1. Copy this file to .env:            cp .env.example .env
# 2. Change every value marked CHANGE ME
# 3. Run:                               docker compose up -d
# ---------------------------------------------------------------------------

# --- Self-hosting (Docker Compose) -----------------------------------------
# Postgres credentials used by the `db` service and the app container.
POSTGRES_USER=openqr
POSTGRES_PASSWORD=change-me-to-a-long-random-password   # CHANGE ME
POSTGRES_DB=openqr

# Port the app is exposed on (host side).
APP_PORT=3000

# The public base URL of your OpenQR instance. Used to build the short links
# that QR codes encode — set this to the URL visitors actually reach.
NEXT_PUBLIC_APP_URL=http://localhost:3000               # CHANGE ME in production

# Salt used to hash IP addresses for unique-scan counting.
# Raw IPs are NEVER stored, but the salt must be random and kept secret so
# the hashes cannot be reversed. Generate one with:
#   openssl rand -hex 32
IP_HASH_SALT=change-me-to-a-long-random-string          # CHANGE ME

# Set to "false" if you prefer to apply schema changes manually
# (docker compose run --rm app bunx prisma db push).
OPENQR_AUTOMIGRATE=true

# --- Local development (no Docker) -----------------------------------------
# For a zero-config SQLite dev database, use:
#   DATABASE_URL=file:./db/custom.db
# and start the app with: bun run dev
DATABASE_URL=file:./db/custom.db
