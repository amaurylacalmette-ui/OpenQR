-- OpenQR — Prisma schema (PostgreSQL variant, used for self-hosted production)
--
-- docker-compose.yml mounts/copies this file as the active schema (the Dockerfile
-- performs `cp prisma/schema.postgres.prisma prisma/schema.prisma` before
-- generating the client). Models are identical to `schema.prisma` (SQLite
-- variant used for zero-config local development).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  qrCodes      QRCode[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  // Store only a SHA-256 hash of the session token — a leaked database dump
  // therefore cannot be used to hijack active sessions.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model QRCode {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  // Unique public identifier used in redirect URLs: /r/{shortCode}
  shortCode        String      @unique
  destinationUrl   String
  isActive         Boolean     @default(true)
  // QR appearance customization
  foregroundColor  String      @default("#000000")
  backgroundColor  String      @default("#FFFFFF")
  size             Int         @default(512) // export size in px (128–2048)
  errorCorrection  String      @default("M") // L | M | Q | H
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  scanEvents       ScanEvent[]

  @@index([userId])
  @@index([shortCode])
  @@index([createdAt])
}

model ScanEvent {
  id        String   @id @default(cuid())
  qrCodeId  String
  qrCode    QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  // Privacy-friendly aggregates only — no raw IP addresses or fingerprints.
  country   String?
  deviceType String? // mobile | tablet | desktop | other
  browser   String?
  os        String?
  referrer  String?
  // Salted SHA-256 hash of the IP address, used exclusively to compute
  // unique-scan counts. The original IP can never be recovered.
  ipHash    String?

  @@index([qrCodeId])
  @@index([createdAt])
  @@index([qrCodeId, createdAt])
  @@index([ipHash])
}
